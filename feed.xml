---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%} Hand-written RSS 2.0 feed (jekyll-feed is not enabled and would give English-only titles). One item per daily digest, bilingual title and summary. {%- endcomment %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title_fr | xml_escape }} / {{ site.title | xml_escape }}</title>
  <link>{{ '/' | absolute_url }}</link>
  <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
  <description>{{ site.description | xml_escape }} / {{ site.description_en | xml_escape }}</description>
  <language>fr-CA</language>
  {%- if site.posts.size > 0 %}
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  {%- endif %}
  {%- for post in site.posts limit: 30 %}
  <item>
    <title>{{ post.title_fr | default: post.title | xml_escape }} / {{ post.title | xml_escape }}</title>
    <link>{{ post.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
    <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    <description>{{ post.summary_fr | default: post.summary | strip_html | xml_escape }} / {{ post.summary | strip_html | xml_escape }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
